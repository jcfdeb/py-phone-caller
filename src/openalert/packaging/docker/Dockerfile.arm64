# syntax=docker/dockerfile:1
# ==============================================================================
# OpenAlert Daemon (openalertd) - ARM64 (aarch64) Multi-Stage Dockerfile
#
# Designed for two ways of building ARM64 images (Raspberry Pi 4/5, Orange Pi Zero 3,
# Rockchip RK3588, AWS Graviton, Hetzner Ampere):
#
#   1. Fast Cross-Compilation from an x86_64 host (NO slow QEMU rustc emulation!):
#      docker buildx build --platform linux/arm64 -f packaging/docker/Dockerfile.arm64 -t openalertd:1.0.0-arm64 --load .
#
#   2. Native compilation directly on an ARM64 Linux host:
#      docker build -f packaging/docker/Dockerfile.arm64 -t openalertd:1.0.0-arm64 .
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Native-Speed Cross-Compiler Builder (runs on $BUILDPLATFORM)
# ------------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM docker.io/library/rust:1-slim-bookworm AS builder

ARG OPENALERT_DIR=.
ARG BUILDPLATFORM

# Enable Debian arm64 multiarch repository and install the aarch64 C/C++ cross-toolchain
# plus target-specific libdbus-1-dev:arm64 and libudev-dev:arm64 headers
RUN dpkg --add-architecture arm64 && \
    apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    build-essential \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    libc6-dev-arm64-cross \
    binutils-aarch64-linux-gnu \
    libdbus-1-dev:arm64 \
    libudev-dev:arm64 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Register the Rust aarch64 target and configure Cargo + pkg-config for arm64 linking
RUN rustup target add aarch64-unknown-linux-gnu

ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig \
    PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig

WORKDIR /usr/src/openalertd

# 1. Dependency caching layer: cross-compile all external crates for aarch64
COPY ${OPENALERT_DIR}/Cargo.toml ${OPENALERT_DIR}/Cargo.lock ./
RUN mkdir -p src && \
    echo "pub fn placeholder() {}" > src/lib.rs && \
    echo "fn main() {}" > src/main.rs && \
    cargo build --release --locked --target aarch64-unknown-linux-gnu && \
    rm -rf src

# 2. Copy actual OpenAlert Rust sources, templates, and default configuration
COPY ${OPENALERT_DIR}/src ./src
COPY ${OPENALERT_DIR}/templates ./templates
COPY ${OPENALERT_DIR}/config ./config

# 3. Cross-compile final aarch64 release binary and strip debug symbols
RUN touch src/lib.rs src/main.rs && \
    cargo build --release --locked --target aarch64-unknown-linux-gnu && \
    aarch64-linux-gnu-strip /usr/src/openalertd/target/aarch64-unknown-linux-gnu/release/openalertd

# ------------------------------------------------------------------------------
# Stage 2: Minimal Hardened ARM64 Production Runtime (linux/arm64)
# ------------------------------------------------------------------------------
FROM --platform=linux/arm64 docker.io/library/debian:bookworm-slim AS runtime

LABEL org.opencontainers.image.title="OpenAlert Daemon (openalertd) [ARM64]" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.architecture="arm64" \
      org.opencontainers.image.description="Decentralized Edge Alert Router for ARM64 SBCs & Servers (Nostr NIP-ALERT, NIP-57 Lightning Zaps, 0xChat NIP-17 C2, BitChat BLE, LoRa RF, GSM SMS)" \
      org.opencontainers.image.authors="Jorge <https://github.com/jcfdeb>" \
      org.opencontainers.image.source="https://github.com/jcfdeb/py-phone-caller" \
      org.opencontainers.image.licenses="BSD-3-Clause"

# Install ARM64 runtime shared libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libdbus-1-3 \
    libudev1 \
    tzdata \
    bluez \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged service user and group (UID/GID 10001) and grant dialout/bluetooth group membership
RUN addgroup --gid 10001 openalert && \
    adduser --uid 10001 --gid 10001 --disabled-password --gecos "" --home /var/lib/openalertd openalert && \
    usermod -aG dialout,bluetooth openalert 2>/dev/null || true

# Prepare runtime filesystem hierarchy
RUN mkdir -p /etc/openalertd /var/lib/openalertd/data /var/lib/openalertd/templates /templates /var/log/openalertd

# Copy stripped aarch64 release binary and runtime assets from builder stage
COPY --from=builder /usr/src/openalertd/target/aarch64-unknown-linux-gnu/release/openalertd /usr/local/bin/openalertd
COPY --from=builder /usr/src/openalertd/config/openalertd.toml /etc/openalertd/openalertd.toml
COPY --from=builder /usr/src/openalertd/config/profiles /etc/openalertd/profiles
COPY --from=builder /usr/src/openalertd/templates/ /templates/
COPY --from=builder /usr/src/openalertd/templates/ /var/lib/openalertd/templates/

# Enforce strict ownership and permissions
RUN chmod 0755 /usr/local/bin/openalertd && \
    chown -R openalert:openalert /etc/openalertd /var/lib/openalertd /templates /var/log/openalertd && \
    chmod 0750 /var/lib/openalertd /etc/openalertd

EXPOSE 8090 8088 19876/udp 19877/udp 19878/udp

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8090/health || exit 1

USER openalert:openalert
WORKDIR /var/lib/openalertd

ENTRYPOINT ["/usr/local/bin/openalertd"]
CMD ["/etc/openalertd/openalertd.toml"]
