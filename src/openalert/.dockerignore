# Exclude cargo build artifacts and distribution bundles
target/
target-arm64/
dist/

# Exclude local SQLite databases and runtime state
data/
*.db
*.db-shm
*.db-wal
*.pid
*.log

# Exclude local configuration overrides, secrets, and environment files
config/*.local.toml
**/*.local.toml
**/.secrets*
**/.env*
**/.vault_pass*

# Exclude git repository metadata
.git/
