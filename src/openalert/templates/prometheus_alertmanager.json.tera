{
  "receiver": "webhook",
  "status": "{{ status | default(value="firing") }}",
  "alerts": [
    {
      "status": "{{ status | default(value="firing") }}",
      "labels": {
        "alertname": {{ alert_id | json_encode }},
        "instance": "{{ instance | default(value="openalertd:8443") }}",
        "job": "openalertd",
        "severity": "{{ severity | default(value="critical") }}",
        "source": "{{ source | default(value="openalert_bus") }}",
        "sender": {{ sender | default(value="openalert-node") | json_encode }}
      },
      "annotations": {
        "summary": {{ summary | default(value=description) | json_encode }},
        "description": {{ summary | default(value=description) | json_encode }}
      },
      "startsAt": "{{ starts_at }}",
      "endsAt": "0001-01-01T00:00:00Z",
      "generatorURL": "{{ generator_url | default(value="openalert://mesh") }}"
    }
  ],
  "groupLabels": {
    "alertname": {{ alert_id | json_encode }}
  },
  "commonLabels": {
    "alertname": {{ alert_id | json_encode }},
    "severity": "{{ severity | default(value="critical") }}",
    "source": "{{ source | default(value="openalert_bus") }}"
  },
  "commonAnnotations": {
    "summary": {{ summary | default(value=description) | json_encode }},
    "description": {{ summary | default(value=description) | json_encode }}
  },
  "externalURL": "http://openalert.local",
  "version": "4",
  "groupKey": "{}:{alertname=\"{{ alert_id }}\"}"
}
