msgstr "Numero di tentativi di chiamata eseguiti finora"

#: src/py_phone_caller_ui/calls/templates/calls/calls.html:115
msgid "Timestamp when receiver pressed DTMF 1 to acknowledge the alert"
msgstr ""
"Data e ora in cui il destinatario ha premuto DTMF 1 per confermare "
"l'avviso"

