msgid "Status"
msgstr "Stato"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:78
msgid "Only active contacts receive automated alerts"
msgstr "Solo i contatti attivi ricevono avvisi automatici"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:156
#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:277
msgid "International format starting with + (e.g. +393349246425)"
msgstr "Formato internazionale che inizia con + (es. +393349246425)"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:211
#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:332
#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:440
msgid "Priority"
msgstr "Priorità"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:211
#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:332
msgid "Priority 0 is dialed first, followed by 1, 2, 3, 4"
msgstr "La priorità 0 viene chiamata per prima, seguita da 1, 2, 3, 4"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:389
msgid "Address Book & On-Call Rotation Guide"
msgstr "Guida rubrica e turni di reperibilità"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:391
msgid ""
"How contact availability, priority escalation, and calendar routing "
"operate."
msgstr ""
"Come funzionano la disponibilità dei contatti, l'escalation delle "
"priorità e l'instradamento a calendario."

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:402
msgid "Contact Details & Phone Numbers"
msgstr "Dettagli contatto e numeri di telefono"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:405
msgid ""
"Contacts must include standard E.164 phone numbers (e.g. +393349246425) "
"to dial properly through Asterisk ARI SIP trunks and GSM modems."
msgstr ""
"I contatti devono includere numeri standard E.164 (es. +393349246425) per"
" comporre correttamente tramite i trunk SIP Asterisk ARI e modem GSM."

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:408
msgid "Active"
msgstr "Attivo"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:408
msgid "Eligible for automated incident calls and SMS."
msgstr "Idoneo per chiamate ed SMS automatici di emergenza."

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:409
msgid "Disabled"
msgstr "Disabilitato"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:409
msgid "Excluded from on-call selection and escalation."
msgstr "Escluso dalla selezione dei reperibili e dall'escalation."

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:417
msgid "Availability Windows & Timezones"
msgstr "Finestre di disponibilità e fusi orari"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:420
msgid ""
"Availability is specified in your local browser timezone. The system "
"automatically converts and stores windows in UTC for accurate global "
"scheduling."
msgstr ""
"La disponibilità è indicata nel fuso orario locale del browser. Il "
"sistema converte e memorizza automaticamente le finestre in UTC per una "
"pianificazione globale accurata."

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:423
msgid ""
"Contacts without explicit windows are considered available 24/7 if "
"enabled."
msgstr ""
"I contatti senza finestre esplicite sono considerati disponibili 24 ore "
"su 24, 7 giorni su 7 se abilitati."

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:431
msgid "Priority Levels & Escalation Rules"
msgstr "Livelli di priorità e regole di escalation"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:434
msgid ""
"When an incident or scheduled call dispatches, the system queries "
"contacts active right now and orders them by Priority:"
msgstr ""
"Quando viene inviata una chiamata di incidente o programmata, il sistema "
"interroga i contatti attivi in quel momento e li ordina per priorità:"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:441
msgid "Role"
msgstr "Ruolo"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:442
msgid "Dispatch Behavior"
msgstr "Comportamento di invio"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:448
msgid "Primary Responder"
msgstr "Reperibile primario"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:449
msgid "First contact dialed when an alert triggers."
msgstr "Primo contatto chiamato quando scatta un allarme."

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:453
msgid "Secondary Responder"
msgstr "Reperibile secondario"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:454
msgid "Contact dialed if Primary fails to answer or acknowledge with DTMF 1."
msgstr "Contatto chiamato se il primario non risponde o non conferma con DTMF 1."

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:458
msgid "Tier 2 / Team Backup"
msgstr "Livello 2 / Backup del team"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:459
msgid "Escalation fallback for high-severity incidents."
msgstr "Ripiego di escalation per incidenti ad alta gravità."

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:463
msgid "Duty Supervisor / Final Fallback"
msgstr "Supervisore di turno / Fallback finale"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:464
msgid "Notified only when earlier tiers are exhausted."
msgstr "Notificato solo quando i livelli precedenti sono esauriti."

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:474
#: src/py_phone_caller_ui/schedule_call/templates/schedule_call/schedule_call.html:345
msgid "Got it"
msgstr "Ho capito"

#: src/py_phone_caller_ui/calls/templates/calls/calls.html:83
