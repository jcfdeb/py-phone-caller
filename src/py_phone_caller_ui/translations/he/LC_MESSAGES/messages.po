msgid "On-Call Guide"
msgstr "מדריך כוננות"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:76
msgid "Contact Name"
msgstr "שם איש קשר"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:76
msgid "First and last name of the responder"
msgstr "שם פרטי ומשפחה של המענה"

#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:77
#: src/py_phone_caller_ui/address_book/templates/address_book/address_book.html:156
