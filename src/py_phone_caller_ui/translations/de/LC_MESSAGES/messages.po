#: src/py_phone_caller_ui/templates/base.html:332
msgid "Help & Documentation"
msgstr "Hilfe und Dokumentation"

#: src/py_phone_caller_ui/templates/base.html:344
msgid "Help Center"
msgstr "Hilfe-Center"

#: src/py_phone_caller_ui/templates/base.html:345
msgid "Sovereign Voice & SMS Alerting"
msgstr "Souveräne Sprach- und SMS-Alarmierung"

#: src/py_phone_caller_ui/templates/base.html:355
msgid "Search help topics..."
msgstr "Hilfethemen suchen..."

#: src/py_phone_caller_ui/templates/base.html:362
msgid "Current section:"
msgstr "Aktueller Bereich:"

#: src/py_phone_caller_ui/templates/base.html:362
#: src/py_phone_caller_ui/templates/base.html:727
msgid "Overview"
msgstr "Übersicht"

#: src/py_phone_caller_ui/templates/base.html:373
#: src/py_phone_caller_ui/templates/base.html:713
msgid "Address Book & On-Call"
msgstr "Adressbuch & Bereitschaft (On-Call)"

#: src/py_phone_caller_ui/templates/base.html:378
msgid "E.164 Phone Numbers:"
msgstr "E.164-Telefonnummern:"

#: src/py_phone_caller_ui/templates/base.html:378
msgid ""
"Store phone numbers with country code (+39...) to dial properly through "
"Asterisk ARI and send SMS."
msgstr ""
"Speichern Sie Telefonnummern mit Ländervorwahl (+39...), um sie "
"ordnungsgemäß über Asterisk ARI zu wählen und SMS zu senden."

#: src/py_phone_caller_ui/templates/base.html:379
msgid "On-Call Availability:"
msgstr "Bereitschaftsverfügbarkeit:"

#: src/py_phone_caller_ui/templates/base.html:379
msgid ""
"Define start/end schedule intervals. Active contacts in the current "
"window are selected automatically."
msgstr ""
"Definieren Sie Start-/End-Zeitintervalle. Aktive Kontakte im aktuellen "
"Zeitfenster werden automatisch ausgewählt."

#: src/py_phone_caller_ui/templates/base.html:380
msgid "Escalation Priority:"
msgstr "Eskalationspriorität:"

#: src/py_phone_caller_ui/templates/base.html:380
msgid ""
"Priority 0 is Primary Responder, 1 is Secondary, 2-3 Backup, 4 Duty "
"Supervisor."
msgstr ""
"Priorität 0 ist Ersthelfer, 1 Zweithelfer, 2-3 Backup, 4 Diensthabender "
"Vorgesetzter."

#: src/py_phone_caller_ui/templates/base.html:381
msgid "CSV Operations:"
msgstr "CSV-Operationen:"

#: src/py_phone_caller_ui/templates/base.html:381
msgid "Import or export entire contact databases at any time."
msgstr ""
"Importieren oder exportieren Sie jederzeit vollständige "
"Kontaktdatenbanken."

#: src/py_phone_caller_ui/templates/base.html:390
#: src/py_phone_caller_ui/templates/base.html:714
msgid "Scheduled Calls & Speech"
msgstr "Geplante Anrufe & Sprache"

#: src/py_phone_caller_ui/templates/base.html:395
msgid "Neural TTS Engine:"
msgstr "Neuronale TTS-Engine:"

#: src/py_phone_caller_ui/templates/base.html:395
msgid ""
"Message text is automatically synthesized into clear 8kHz/16kHz audio "
"using Silero Neural TTS."
msgstr ""
"Der Nachrichtentext wird mit Silero Neural TTS automatisch in klares "
"8-kHz-/16-kHz-Audio umgewandelt."

#: src/py_phone_caller_ui/templates/base.html:396
msgid "Audio Caching:"
msgstr "Audio-Zwischenspeicherung:"

#: src/py_phone_caller_ui/templates/base.html:396
msgid ""
"Synthesized audio is cached locally by message hash for instant zero-"
"latency playback."
msgstr ""
"Synthetisiertes Audio wird lokal nach Nachrichten-Hash "
"zwischengespeichert, für sofortige latenzfreie Wiedergabe."

#: src/py_phone_caller_ui/templates/base.html:397
msgid "Smart Recipient Picker:"
msgstr "Intelligente Empfängerauswahl:"

#: src/py_phone_caller_ui/templates/base.html:397
msgid ""
"Choose a specific contact or select \"Use current On-call\" to resolve "
"on-duty responders."
msgstr ""
"Wählen Sie einen bestimmten Kontakt oder \"Aktuelle Bereitschaft "
"verwenden\", um zuständige Personen zu ermitteln."

#: src/py_phone_caller_ui/templates/base.html:406
#: src/py_phone_caller_ui/templates/base.html:715
msgid "Managed Calls & DTMF"
msgstr "Verwaltete Anrufe & DTMF"

#: src/py_phone_caller_ui/templates/base.html:411
msgid "Asterisk ARI Integration:"
msgstr "Asterisk-ARI-Integration:"

#: src/py_phone_caller_ui/templates/base.html:411
msgid ""
"Channels are initiated via Asterisk REST Interface and placed in Stasis "
"bridge."
msgstr ""
"Kanäle werden über die Asterisk-REST-Schnittstelle initiiert und in die "
"Stasis-Bridge geleitet."

#: src/py_phone_caller_ui/templates/base.html:412
msgid "DTMF 1 Acknowledgment:"
msgstr "DTMF-1-Bestätigung:"

#: src/py_phone_caller_ui/templates/base.html:412
msgid ""
"The recipient presses 1 to acknowledge the alert, marking it acknowledged"
" and terminating retries."
msgstr ""
"Der Empfänger drückt 1 zur Bestätigung des Alarms, was ihn als bestätigt "
"markiert und Wiederholungen beendet."

#: src/py_phone_caller_ui/templates/base.html:413
msgid "Automatic Retries:"
msgstr "Automatische Wiederholungen:"

#: src/py_phone_caller_ui/templates/base.html:413
msgid ""
"Unanswered calls automatically retry according to retry count and backoff"
" configuration."
msgstr ""
"Unbeantwortete Anrufe werden basierend auf Wiederholungsanzahl und "
"Backoff-Konfiguration automatisch wiederholt."

#: src/py_phone_caller_ui/templates/base.html:422
#: src/py_phone_caller_ui/templates/base.html:716
msgid "SMS & GSM Modems"
msgstr "SMS & GSM-Modems"

#: src/py_phone_caller_ui/templates/base.html:427
msgid "On-Premise Hardware Modems:"
msgstr "Lokale Hardware-Modems:"

#: src/py_phone_caller_ui/templates/base.html:427
msgid ""
"SMS is dispatched directly via serial AT commands (/dev/ttyUSB) without "
"external dependencies."
msgstr ""
"SMS werden direkt über serielle AT-Befehle (/dev/ttyUSB) ohne externe "
"Abhängigkeiten versendet."

#: src/py_phone_caller_ui/templates/base.html:428
msgid "Carrier Failover:"
msgstr "Betreiber-Failover:"

#: src/py_phone_caller_ui/templates/base.html:428
msgid ""
"If GSM signal is lost or modem fails, failover to secondary gateway (e.g."
" Twilio) triggers automatically."
msgstr ""
"Bei Verlust des GSM-Signals oder Ausfall des Modems wird automatisch auf "
"das sekundäre Gateway (z. B. Twilio) umgeschaltet."

#: src/py_phone_caller_ui/templates/base.html:429
msgid "Full Delivery Tracking:"
msgstr "Vollständige Zustellungsverfolgung:"

#: src/py_phone_caller_ui/templates/base.html:429
msgid ""
"View outbound SMS logs, delivery statuses, carrier metadata, and "
"timestamps in real time."
msgstr ""
"Sehen Sie ausgehende SMS-Protokolle, Zustellstatus, Netzbetreiber-"
"Metadaten und Zeitstempel in Echtzeit."

#: src/py_phone_caller_ui/templates/base.html:438
#: src/py_phone_caller_ui/templates/base.html:717
msgid "PBX Events & Telephony Stream"
msgstr "PBX-Ereignisse & Telefonie-Stream"

#: src/py_phone_caller_ui/templates/base.html:443
msgid "WebSocket Event Feed:"
msgstr "WebSocket-Ereignis-Feed:"

#: src/py_phone_caller_ui/templates/base.html:443
msgid ""
"Real-time feed of Asterisk ARI events including StasisStart, "
"ChannelDtmfReceived, and ChannelDestroyed."
msgstr ""
"Echtzeit-Feed von Asterisk-ARI-Ereignissen einschließlich StasisStart, "
"ChannelDtmfReceived und ChannelDestroyed."

#: src/py_phone_caller_ui/templates/base.html:444
msgid "Troubleshooting Audits:"
msgstr "Fehlerbehebungs-Audits:"

#: src/py_phone_caller_ui/templates/base.html:444
msgid ""
"Use the event timeline to diagnose call setup delays, SIP trunk "
"responses, and DTMF tones."
msgstr ""
"Nutzen Sie die Ereignis-Zeitleiste, um Verbindungsverzögerungen, SIP-"
"Trunk-Antworten und DTMF-Töne zu diagnostizieren."

#: src/py_phone_caller_ui/templates/base.html:453
#: src/py_phone_caller_ui/templates/base.html:712
msgid "Prometheus & Webhook Triggering"
msgstr "Prometheus & Webhook-Auslösung"

#: src/py_phone_caller_ui/templates/base.html:458
msgid "Alertmanager Receiver:"
msgstr "Alertmanager-Empfänger:"

#: src/py_phone_caller_ui/templates/base.html:458
msgid "Configure Alertmanager to forward firing alerts to the webhook service:"
msgstr ""
"Konfigurieren Sie Alertmanager so, dass auslösende Alarme an den Webhook-"
"Dienst weitergeleitet werden:"

#: src/py_phone_caller_ui/templates/base.html:462
msgid ""
"Incoming alerts automatically resolve duty on-call contacts, synthesize "
"speech, and initiate emergency phone calls."
msgstr ""
"Eingehende Alarme ermitteln automatisch zuständige Bereitschaftskontakte,"
" synthetisieren Sprache und leiten Notrufe ein."

#: src/py_phone_caller_ui/templates/base.html:471
msgid "Need to test right now?"
msgstr "Möchten Sie jetzt direkt testen?"

#: src/py_phone_caller_ui/templates/base.html:472
msgid "Send a live test call or SMS from the diagnostics console."
msgstr "Senden Sie einen Live-Testanruf oder eine SMS über die Diagnosekonsole."

#: src/py_phone_caller_ui/templates/base.html:474
msgid "Open Diagnostics Console"
msgstr "Diagnosekonsole öffnen"

