#: src/py_phone_caller_ui/home/templates/home/home.html:169
msgid "Heard / Snoozed"
msgstr "सुना / स्नूज़ किया गया"

#: src/py_phone_caller_ui/home/templates/home/home.html:174
msgid "Escalated"
msgstr "एस्केलेट किया गया"

#: src/py_phone_caller_ui/home/templates/home/home.html:179
