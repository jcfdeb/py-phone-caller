msgstr "¿Necesita probar ahora mismo?"

#: src/py_phone_caller_ui/templates/base.html:482
msgid "Send a live test call or SMS from the diagnostics console."
msgstr "Envíe una llamada o SMS de prueba en vivo desde la consola de diagnóstico."

