{% if py_phone_caller_topology | default('legacy') != 'legacy' %}
KC_DB=postgres
KC_DB_URL={{ gateway_keycloak_postgresql_url }}
KC_DB_USERNAME={{ gateway_keycloak_postgresql_username }}
KC_DB_PASSWORD={{ gateway_keycloak_postgresql_password }}
KC_BOOTSTRAP_ADMIN_USERNAME={{ py_phone_caller_keycloak_admin_user }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ _ppc_keycloak_admin_password }}
KC_CACHE=local
KC_HTTP_ENABLED=true
KC_HTTP_HOST=127.0.0.1
KC_HTTP_PORT={{ py_phone_caller_keycloak_http_port }}
KC_HTTP_MANAGEMENT_HOST=127.0.0.1
KC_HTTP_MANAGEMENT_PORT=9009
KC_HOSTNAME={{ py_phone_caller_public_url }}
KC_HOSTNAME_STRICT=true
KC_PROXY_HEADERS=xforwarded
KC_PROXY_TRUSTED_ADDRESSES=127.0.0.1,::1
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
{% else %}
KC_DB_PASSWORD={{ _ppc_keycloak_db_password }}
KEYCLOAK_ADMIN_PASSWORD={{ _ppc_keycloak_admin_password }}
{% endif %}