# ===========================================================================
# py-phone-caller Server Credentials & Gateway Access
# Managed by Ansible (deploy_py-phone-caller)
# File permissions: 0600 root:root
# ===========================================================================

# Target host: {{ inventory_hostname }} ({{ ansible_host | default(inventory_hostname) }})
# Generated at: {{ ansible_date_time.iso8601 | default('N/A') }}

{% if py_phone_caller_manage_gateway | bool %}
# --- Keycloak IAM Master Admin ---
KEYCLOAK_URL={{ _ppc_effective_public_url }}
KEYCLOAK_REALM={{ py_phone_caller_keycloak_realm }}
KEYCLOAK_ADMIN_USER={{ py_phone_caller_keycloak_admin_user }}
KEYCLOAK_ADMIN_PASSWORD={{ _ppc_keycloak_admin_password }}
KEYCLOAK_DB_NAME={{ py_phone_caller_keycloak_db_name }}
KEYCLOAK_DB_USER={{ py_phone_caller_keycloak_db_user }}
KEYCLOAK_DB_PASSWORD={{ _ppc_keycloak_db_password }}

# --- Keycloak Realm End Users (SSO Login) ---
KEYCLOAK_USER_ADMIN=admin_user
KEYCLOAK_USER_ADMIN_PASSWORD={{ _ppc_keycloak_user_admin_password }}
KEYCLOAK_USER_OPERATOR=operator_user
KEYCLOAK_USER_OPERATOR_PASSWORD={{ _ppc_keycloak_user_operator_password }}
KEYCLOAK_USER_VIEWER=viewer_user
KEYCLOAK_USER_VIEWER_PASSWORD={{ _ppc_keycloak_user_viewer_password }}

# --- Keycloak OIDC Clients ---
KEYCLOAK_UI_CLIENT_ID={{ py_phone_caller_keycloak_ui_client_id }}
KEYCLOAK_M2M_CLIENT_ID={{ py_phone_caller_keycloak_m2m_client_id }}
KEYCLOAK_M2M_CLIENT_SECRET={{ _ppc_keycloak_m2m_client_secret }}

# --- Apache APISIX Gateway ---
APISIX_GATEWAY_URL={{ _ppc_effective_public_url }}
APISIX_HTTP_PORT={{ py_phone_caller_gateway_http_port }}
APISIX_HTTPS_PORT={{ py_phone_caller_gateway_https_port }}
APISIX_ADMIN_TOKEN={{ py_phone_caller_apisix_admin_token }}
APISIX_DASHBOARD_URL=http://{{ ansible_host | default(inventory_hostname) }}:{{ py_phone_caller_gateway_dashboard_port }}
APISIX_DASHBOARD_USER={{ py_phone_caller_apisix_dashboard_user }}
APISIX_DASHBOARD_PASSWORD={{ _ppc_apisix_dashboard_password }}
{% endif %}

# --- Database & Application Secrets ---
DATABASE_NAME={{ py_phone_caller_final_config.database.db_name | default('') }}
DATABASE_USER={{ py_phone_caller_final_config.database.db_user | default('') }}
DATABASE_PASSWORD={{ py_phone_caller_final_config.database.db_password | default('') }}

# --- Web UI Local Fallback Login ---
UI_ADMIN_USER={{ py_phone_caller_final_config.py_phone_caller_ui.ui_admin_user | default('admin@py-phone-caller.link') }}
UI_ADMIN_PASSWORD={{ _ppc_web_ui_admin_password }}
