[Unit]
Description=Podman container-caller_register.service
Documentation=man:podman-generate-systemd(1)
Wants=network.target
After=network-online.target
After=container-postgres.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
TimeoutStopSec=70
ExecStart=/usr/bin/podman start caller_register
ExecStop=/usr/bin/podman stop -t 10 caller_register
ExecStopPost=/usr/bin/podman stop -t 10 caller_register
Type=forking

[Install]
WantedBy=multi-user.target default.target
